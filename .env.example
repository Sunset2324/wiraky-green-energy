# Salin file ini menjadi ".env" lalu isi nilainya. JANGAN commit file .env.
#   Windows (cmd):  copy .env.example .env
#   Mac/Linux:      cp .env.example .env

# --- Xendit (gunakan key SANDBOX / Test mode saja untuk demo) ---
# Dashboard > Test mode > Settings > API Keys > Generate secret key
# Permission "Invoices" harus WRITE. Jika tidak, Xendit membalas 403 REQUEST_FORBIDDEN_ERROR.
XENDIT_SECRET_KEY=xnd_development_ISI_DI_SINI

# Dashboard > Test mode > Settings > Webhooks > Verification token
# Wajib diisi agar webhook /webhook/xendit diterima (kosong = semua webhook ditolak 503).
XENDIT_CALLBACK_TOKEN=ISI_VERIFICATION_TOKEN_DI_SINI

# --- Server ---
# Port yang dipakai app Flask. Port yang di-forward di VS Code harus sama dengan ini.
PORT=5500

# 1 hanya untuk development lokal. Untuk demo lewat tunnel/port forward WAJIB 0.
FLASK_DEBUG=0

# =====================================================================
# Integrasi Standar API Integrated (app.py) - Green Energy <-> Finance Wiraky
# Jalankan:  APP_ENTRY=app.py ./start_demo.sh   atau   python app.py
# =====================================================================
# KOSONG = mode SIMULATOR (Finance disimulasikan di /finance-sim, secret acak per proses, hanya untuk demo).
# Diisi   = mode FINANCE_API (sistem Finance asli). Wajib HTTPS dan kedua secret di bawah.
WIRAKY_FINANCE_API_URL=
# Secret arah Green Energy -> Finance (tanda tangan request kita). Min. 16 karakter.
WIRAKY_FINANCE_API_SECRET=
# Secret arah Finance -> Green Energy (callback). HARUS BERBEDA dari secret di atas. Min. 16 karakter.
WIRAKY_FINANCE_CALLBACK_SECRET=
# Saat rotasi: secret lama callback tetap diterima sementara (hapus setelah Finance berpindah).
WIRAKY_FINANCE_CALLBACK_SECRET_PREVIOUS=
# Opsional (nilai default sesuai standar)
# OUTBOX_MAX_ATTEMPTS=6
# OUTBOX_BACKOFF_BASE=2
# OUTBOX_BACKOFF_CAP=300
# TIMESTAMP_MAX_AGE=300
# RECONCILE_AFTER_SECONDS=120
# WEBHOOK_RATE_LIMIT_PER_MINUTE=120
# ENABLE_FINANCE_SIMULATOR=1

# =====================================================================
# WhatsApp Business (Cloud API) - notifikasi ke pelanggan. Panduan: docs/WA_BUSINESS_SETUP.md
# Default (WA_ENABLED kosong/0) = mode LOG: tidak ada pesan nyata terkirim, hanya pratinjau di /whatsapp.
# =====================================================================
WA_ENABLED=0
# Phone number ID dari Meta (angka), BUKAN nomor telepon.
WA_PHONE_NUMBER_ID=
# System User token permanen (permission whatsapp_business_messaging). RAHASIA, jangan di-commit.
WA_ACCESS_TOKEN=
# App Secret (Meta App > Settings > Basic): memverifikasi X-Hub-Signature-256 pada webhook status.
WA_APP_SECRET=
# Token bebas buatan Anda; isi sama di konfigurasi webhook Meta.
WA_VERIFY_TOKEN=
# Opsional
# WA_API_VERSION=v21.0
# WA_TEMPLATE_LANGUAGE=id
# WA_TEMPLATE_BILL_ISSUED=additional_cost_bill
# WA_TEMPLATE_PAYMENT_CONFIRMED=additional_cost_paid
# WA_NOTIFY_KINDS=BILL_ISSUED,PAYMENT_CONFIRMED
# WA_MAX_ATTEMPTS=5
