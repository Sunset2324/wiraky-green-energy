# ============================================
# KONFIGURASI STANDAR API INTEGRATED v1.0
# ============================================

# 1. MODE SIMULASI (WAJIB 'true' sampai Tim IT memberikan URL produksi asli)
SIMULATE_FINANCE_API=true

# 2. URL API Finance (Akan diabaikan selama SIMULATE_FINANCE_API=true)
# Nanti diganti dengan URL UAT/Production asli dari Tim IT Wiraky
WIRAKY_FINANCE_API_URL=https://finance.wnt.co.id/api/v1

# 3. Secret untuk KIRIM request ke Finance (HMAC signing)
WIRAKY_FINANCE_API_SECRET=6a5bf1b470c173bde59bb2a70239bf81cb5b4021464ad25178acc06bae20022d

# 4. Secret untuk TERIMA webhook dari Finance (HMAC verification)
WIRAKY_FINANCE_CALLBACK_SECRET=80a48b13dcfc42fbf06238b75ff5262cb34af7a77d100fcc636aafbe64beba96

# 5. URL Callback Webhook Green Energy (Berikan URL ini ke Tim IT Finance Wiraky)
GREEN_ENERGY_CALLBACK_URL=https://ge.wnt.co.id/api/v1/finance/payment-events

# 6. URL Aplikasi Green Energy (untuk link di notifikasi internal/dashboard)
APP_URL=https://ge.wnt.co.id

# 7. Nomor internal untuk notifikasi darurat (Pak Yudi/Finance)
INTERNAL_COORDINATOR_PHONE=6281234567890

# 8. Secret key Flask
SECRET_KEY=change-this-to-random-string

WA_ENABLED=1
WA_PHONE_NUMBER_ID=<Phone number ID dari halaman Meta>
WA_ACCESS_TOKEN=<token dari Meta>
WA_APP_SECRET=<Meta App > Settings > Basic > App Secret>
WA_VERIFY_TOKEN=wiraky-jupUmLGRHYrACZFB4wzvxbiXLSkfEylM