# ============================================
# KONFIGURASI LAMA (HAPUS/COMMENT)
# ============================================
# XENDIT_SECRET_KEY=...
# XENDIT_CALLBACK_TOKEN=...
# WA_API_URL=...
# WA_API_TOKEN=...

# ============================================
# KONFIGURASI BARU - STANDAR API INTEGRATED v1.0
# ============================================

# URL API Sistem Keuangan Wiraky (UAT/Production ditentukan Tim IT Wiraky)
WIRAKY_FINANCE_API_URL=https://finance-api.example.test/api/v1

# Secret untuk KIRIM request ke Finance (HMAC signing)
WIRAKY_FINANCE_API_SECRET=your_api_secret_for_sending

# Secret untuk TERIMA webhook dari Finance (HMAC verification)
# PENTING: Harus berbeda dengan API_SECRET di atas!
WIRAKY_FINANCE_CALLBACK_SECRET=your_callback_secret_for_receiving

# URL callback Green Energy (diberitahukan ke Tim Finance Wiraky)
GREEN_ENERGY_CALLBACK_URL=https://greenenergy.example.test/api/v1/finance/payment-events

# Nomor internal untuk notifikasi darurat (opsional, jika diperlukan)
INTERNAL_COORDINATOR_PHONE=6281234567890

# URL aplikasi (untuk link di notifikasi internal)
APP_URL=https://greenenergy.example.test

# Secret key Flask
SECRET_KEY=change-this-to-random-string